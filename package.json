{
  "name": "form-keeper",
  "version": "0.5.0",
  "description": "Chrome extension that saves form state on dev hosts and restores it after reload.",
  "private": true,
  "license": "MIT",
  "author": "Munawirul Hadi",
  "repository": "github:heyhadi/form-keeper",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "fixtures": "vite --config fixtures/vite.config.ts",
    "e2e": "FK_E2E=1 wxt build && playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-select": "^2.3.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.4",
    "@wxt-dev/module-react": "^1.2.2",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.0",
    "react-select": "^5.10.2",
    "react-select-v4": "npm:react-select@^4.3.1",
    "svelte": "^5.57.2",
    "svelte-select": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "wxt": "^0.21.4"
  }
}
